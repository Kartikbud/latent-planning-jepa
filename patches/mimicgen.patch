         return PoseUtils.make_pose(obj_pos, obj_rot)
 
 
+class MG_Lift(RobosuiteInterface):
+    """Corresponds to the robosuite Lift task and variants."""
+
+    def get_object_poses(self):
+        return dict(
+            cube=self.get_object_pose(
+                obj_name=self.env.cube.root_body,
+                obj_type="body",
+            ),
+        )
+
+    def get_subtask_term_signals(self):
+        # The one-subtask Lift config does not need this boundary, but storing
+        # it keeps source datasets compatible with MimicGen's HDF5 parser and
+        # allows a future reach/grasp + lift task split without re-annotation.
+        return dict(
+            grasp=int(self.env._check_grasp(
+                gripper=self.env.robots[0].gripper,
+                object_geoms=self.env.cube,
+            )),
+        )
+
+
