+class Lift_Config(MG_Config):
+    """Corresponds to the robosuite Lift task and variants."""
+
+    NAME = "lift"
+    TYPE = "robosuite"
+
+    def task_config(self):
+        # The complete reach-grasp-lift motion is one object-centric subtask.
+        # The final subtask always terminates at the end of the demonstration.
+        self.task.task_spec.subtask_1 = dict(
+            object_ref="cube",
+            subtask_term_signal=None,
+            subtask_term_offset_range=None,
+            selection_strategy="nearest_neighbor_object",
+            selection_strategy_kwargs=dict(nn_k=3),
+            action_noise=0.05,
+            num_interpolation_steps=5,
+            num_fixed_steps=0,
+            apply_noise_during_interpolation=False,
+        )
+        self.task.task_spec.do_not_lock_keys()
+
